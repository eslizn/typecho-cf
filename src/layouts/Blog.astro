---
import Base from './Base.astro';
import type { SiteOptions } from '@/lib/options';
import type { computeUrls } from '@/lib/options';
import type { I18n } from '@/lib/i18n';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  options: SiteOptions;
  urls: ReturnType<typeof computeUrls>;
  user?: any;
  isLoggedIn?: boolean;
  pages?: Array<{ title: string; slug: string; permalink: string }>;
  currentSlug?: string;
  showSidebar?: boolean;
  sidebarData?: {
    recentPosts?: Array<{ title: string; permalink: string }>;
    recentComments?: Array<{ author: string; excerpt: string; permalink: string }>;
    categories?: Array<{ name: string; slug: string; count: number; permalink: string }>;
    archives?: Array<{ date: string; permalink: string }>;
  };
  i18n?: I18n;
}

const {
  title,
  description,
  keywords,
  options,
  urls,
  user,
  isLoggedIn = false,
  pages = [],
  currentSlug,
  showSidebar = true,
  sidebarData,
  i18n,
} = Astro.props;

const currentPath = new URL(Astro.request.url).pathname;
const isIndex = currentPath === '/';
const t = (key: string, variables: Record<string, string | number> = {}, fallback = key): string =>
  i18n?.t(key, variables, fallback) ?? fallback;
---
<Base
  title={title}
  description={description}
  keywords={keywords}
  options={options}
  urls={urls}
  user={user}
  isLoggedIn={isLoggedIn}
  i18n={i18n}
>
  <header id="header" class="clearfix">
    <div class="container">
      <div class="row">
        <div class="site-name col-mb-12 col-9">
          <a id="logo" href={urls.siteUrl + '/'}>{options.title}</a>
          <p class="description">{options.description}</p>
        </div>
        <div class="site-search col-3 kit-hidden-tb">
          <form id="search" method="post" action={urls.siteUrl + '/'} role="search">
            <label for="s" class="sr-only">{t('core.frontend.searchLabel', {}, 'Search keywords')}</label>
            <input type="text" id="s" name="s" class="text" placeholder={t('core.frontend.searchPlaceholder', {}, 'Search')} />
            <button type="submit" class="submit">{t('core.frontend.searchSubmit', {}, 'Search')}</button>
          </form>
        </div>
        <div class="col-mb-12">
          <nav id="nav-menu" class="clearfix" role="navigation">
            <a class:list={[{ current: isIndex }]} href={urls.siteUrl + '/'}>{t('core.frontend.home', {}, 'Home')}</a>
            {pages.map((page) => (
              <a
                class:list={[{ current: currentSlug === page.slug }]}
                href={page.permalink}
                title={page.title}
              >
                {page.title}
              </a>
            ))}
          </nav>
        </div>
      </div>
    </div>
  </header>

  <div id="body">
    <div class="container">
      <div class="row">
        <slot />

        {showSidebar && sidebarData && (
          <div class="col-mb-12 col-offset-1 col-3 kit-hidden-tb" id="secondary" role="complementary">
            {sidebarData.recentPosts && sidebarData.recentPosts.length > 0 && (
              <section class="widget">
                <h3 class="widget-title">{t('core.frontend.recentPosts', {}, 'Recent posts')}</h3>
                <ul class="widget-list">
                  {sidebarData.recentPosts.map((post) => (
                    <li><a href={post.permalink}>{post.title}</a></li>
                  ))}
                </ul>
              </section>
            )}

            {sidebarData.recentComments && sidebarData.recentComments.length > 0 && (
              <section class="widget">
                <h3 class="widget-title">{t('core.frontend.recentComments', {}, 'Recent comments')}</h3>
                <ul class="widget-list">
                  {sidebarData.recentComments.map((comment) => (
                    <li>
                      <a href={comment.permalink}>{comment.author}</a>: {comment.excerpt}
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {sidebarData.categories && sidebarData.categories.length > 0 && (
              <section class="widget">
                <h3 class="widget-title">{t('core.frontend.categories', {}, 'Categories')}</h3>
                <ul class="widget-list">
                  {sidebarData.categories.map((cat) => (
                    <li><a href={cat.permalink}>{cat.name} ({cat.count})</a></li>
                  ))}
                </ul>
              </section>
            )}

            {sidebarData.archives && sidebarData.archives.length > 0 && (
              <section class="widget">
                <h3 class="widget-title">{t('core.frontend.archives', {}, 'Archives')}</h3>
                <ul class="widget-list">
                  {sidebarData.archives.map((archive) => (
                    <li><a href={archive.permalink}>{archive.date}</a></li>
                  ))}
                </ul>
              </section>
            )}

            <section class="widget">
              <h3 class="widget-title">{t('core.frontend.other', {}, 'Other')}</h3>
              <ul class="widget-list">
                {isLoggedIn ? (
                  <>
                    <li class="last">
                      <a href={urls.adminUrl}>{t('core.frontend.admin', { name: user?.screenName || user?.name || '' }, 'Admin ({name})')}</a>
                    </li>
                    <li><form method="post" action={urls.logoutUrl} class="logout-form"><button type="submit">{t('core.frontend.logout', {}, 'Log out')}</button></form></li>
                  </>
                ) : (
                  <li class="last"><a href={urls.loginUrl}>{t('core.frontend.login', {}, 'Log in')}</a></li>
                )}
                <li><a href={urls.feedUrl}>{t('core.frontend.postsRss', {}, 'Posts RSS')}</a></li>
                <li><a href={urls.commentsFeedUrl}>{t('core.frontend.commentsRss', {}, 'Comments RSS')}</a></li>
              </ul>
            </section>
          </div>
        )}
      </div>
    </div>
  </div>

  <footer id="footer" role="contentinfo">
    &copy; {new Date().getFullYear()} <a href={urls.siteUrl}>{options.title}</a>.
    {t('core.frontend.poweredBy', {}, 'Powered by Typecho CF')}.
  </footer>
</Base>
