---
// Standalone page — no Admin layout (user is not logged in).
// Pattern matches login.astro.
import { createContext } from '@/lib/context';
import { createCoreRequestI18n } from '@/lib/i18n-runtime';

let i18n = createCoreRequestI18n(Astro.request).i18n;
let charset = 'UTF-8';
try {
  const ctx = await createContext(Astro.locals, Astro.request);
  i18n = ctx.i18n;
  charset = String(ctx.options.charset || charset);
} catch {
  // The core translator is enough when the database is not ready.
}
---

<!DOCTYPE html>
<html lang={i18n.locale}>
<head>
  <meta charset={charset} />
  <meta name="renderer" content="webkit" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{i18n.t('admin.page.forgotPassword', {}, 'Forgot password')}</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="stylesheet" href="/css/normalize.css" />
  <link rel="stylesheet" href="/css/grid.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
  <div class="typecho-login-wrap">
    <div class="typecho-login">
      <h1><a href="/">{i18n.t('admin.page.forgotPassword', {}, 'Forgot password')}</a></h1>
      <form action="/api/users/forgot-password" method="post">
        <p>
          <label for="email" class="sr-only">{i18n.t('admin.field.email', {}, 'Email')}</label>
          <input type="email" id="email" name="email" class="text w-100" placeholder={i18n.t('admin.auth.emailPlaceholder', {}, 'Enter your registered email')} required autofocus />
        </p>
        <p class="submit">
          <button type="submit" class="btn primary w-100">{i18n.t('admin.auth.sendResetLink', {}, 'Send reset link')}</button>
        </p>
      </form>
      <p class="more-link">
        <a href="/admin/login">{i18n.t('admin.auth.backToLogin', {}, 'Back to login')}</a>
      </p>
    </div>
  </div>
</body>
</html>
