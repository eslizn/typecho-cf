---
import Admin from '@/layouts/Admin.astro';
import { createContext, requireAuth } from '@/lib/context';
import { hasPermission } from '@/lib/auth';
import { eq, and, desc, sql } from 'drizzle-orm';
import { schema } from '@/db';
import { formatDate } from '@/lib/content';
import { parsePageNumber, withQueryParams } from '@/lib/input';

const ctx = await createContext(Astro.locals, Astro.request);
const authCheck = requireAuth(ctx);
if (authCheck) return authCheck;

if (!hasPermission(ctx.user!.group || 'visitor', 'editor')) {
  return new Response(ctx.i18n.t('core.error.forbidden', {}, 'Forbidden'), { status: 403 });
}

const { db, options, urls, user, csrfToken } = ctx;
const isAdmin = hasPermission(user!.group || 'visitor', 'administrator');

const page = parsePageNumber(Astro.url.searchParams.get('page'));
const keywords = (Astro.url.searchParams.get('keywords') || '').trim().slice(0, 50);
const pageSize = 20;

// Build conditions
const conditions: any[] = [eq(schema.contents.type, 'attachment')];
if (!isAdmin) {
  conditions.push(eq(schema.contents.authorId, user!.uid));
}
if (keywords) {
  conditions.push(sql`${schema.contents.title} LIKE ${'%' + keywords + '%'}`);
}

const where = and(...conditions);

const [countResult, attachmentRows] = await db.batch([
  db.select({ count: sql<number>`count(*)` }).from(schema.contents).where(where),
  db.select({
    attachment: schema.contents,
    authorName: sql<string | null>`(
      SELECT ${schema.users.name} FROM ${schema.users}
      WHERE ${schema.users.uid} = ${schema.contents.authorId}
      LIMIT 1
    )`,
    authorScreenName: sql<string | null>`(
      SELECT ${schema.users.screenName} FROM ${schema.users}
      WHERE ${schema.users.uid} = ${schema.contents.authorId}
      LIMIT 1
    )`,
    parentTitle: sql<string | null>`(
      SELECT parent.title FROM ${schema.contents} AS parent
      WHERE parent.cid = ${schema.contents.parent}
      LIMIT 1
    )`,
  }).from(schema.contents)
    .where(where)
    .orderBy(desc(schema.contents.created))
    .limit(pageSize)
    .offset((page - 1) * pageSize),
]);
const attachments = attachmentRows.map(row => row.attachment);
const totalItems = countResult[0]?.count || 0;
const totalPages = Math.max(1, Math.ceil(totalItems / pageSize));
const relatedByCid = new Map(attachmentRows.map(row => [row.attachment.cid, row]));

// Parse attachment meta
function parseMeta(text: string) {
  try { return JSON.parse(text || '{}'); } catch { return {}; }
}

const imageExtensions = ['jpg', 'jpeg', 'png', 'gif', 'webp', 'svg', 'bmp', 'avif'];

function isImageFile(meta: any): boolean {
  const mimeType = meta.type || '';
  return mimeType.startsWith('image/')
    || imageExtensions.includes(mimeType.toLowerCase())
    || imageExtensions.some(ext => (meta.name || '').toLowerCase().endsWith('.' + ext));
}

function resolveFileUrl(meta: any): string {
  if (meta.url) return meta.url;
  if (meta.path) return '/' + meta.path.replace(/^\//, '');
  return '';
}

function formatBytes(bytes: number): string {
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024 * 1024) return Math.ceil(bytes / 1024) + ' KB';
  return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
}
---
<Admin title={ctx.i18n.t('admin.page.manageMedias', {}, 'Manage media')} options={options} urls={urls} user={user} activeMenu="manage-medias" pluginCtx={ctx}>
  <div class="col-mb-12 typecho-list">
    <div class="typecho-list-operate clearfix">
      <form method="get">
        <div class="operate">
          <label><i class="sr-only">{ctx.i18n.t('admin.action.selectAll', {}, 'Select all')}</i><input type="checkbox" class="typecho-table-select-all" /></label>
          <div class="btn-group btn-drop">
            <button class="btn dropdown-toggle btn-s" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="media-actions-top"><i class="sr-only">{ctx.i18n.t('admin.action.actions', {}, 'Actions')}</i>{ctx.i18n.t('admin.notice.selectAction', {}, 'Select an action')} <i class="i-caret-down"></i></button>
            <ul class="dropdown-menu" id="media-actions-top" role="menu">
              <li><a href="/api/admin/media-batch?do=delete">{ctx.i18n.t('admin.action.delete', {}, 'Delete')}</a></li>
            </ul>
          </div>
        </div>
        <div class="search" role="search">
          {keywords && <a href="/admin/manage-medias">&laquo; {ctx.i18n.t('admin.action.clearFilter', {}, 'Clear filter')}</a>}
          <input type="text" class="text-s" placeholder={ctx.i18n.t('admin.search.placeholder', {}, 'Enter keywords')} value={keywords} name="keywords" />
          <button type="submit" class="btn btn-s">{ctx.i18n.t('admin.action.filter', {}, 'Filter')}</button>
        </div>
      </form>
    </div>

    <form method="post" name="manage_medias" class="operate-form">
      <input type="hidden" name="_" value={csrfToken} />
      <div class="typecho-table-wrap">
        <table class="typecho-list-table">
          <colgroup>
            <col class="typecho-select-cell" />
            <col width="45%" />
            <col width="" class="kit-hidden-mb" />
            <col width="18%" class="kit-hidden-mb" />
            <col width="16%" />
          </colgroup>
          <thead>
            <tr>
              <th class="typecho-select-cell"></th>
              <th>{ctx.i18n.t('admin.field.fileName', {}, 'File name')}</th>
              <th class="kit-hidden-mb">{ctx.i18n.t('admin.field.owner', {}, 'Owner')}</th>
              <th class="kit-hidden-mb">{ctx.i18n.t('admin.field.contentOwner', {}, 'Attached to')}</th>
              <th>{ctx.i18n.t('admin.field.date', {}, 'Date')}</th>
            </tr>
          </thead>
          <tbody>
            {attachments.length === 0 ? (
              <tr>
                <td colspan="5"><h6 class="typecho-list-table-title">{ctx.i18n.t('admin.notice.noMedia', {}, 'No media')}</h6></td>
              </tr>
            ) : (
              attachments.map((att) => {
                const meta = parseMeta(att.text || '');
                const related = relatedByCid.get(att.cid);
                const authorName = related?.authorScreenName || related?.authorName;
                const parentTitle = related?.parentTitle;
                const isImage = isImageFile(meta);
                const fileUrl = resolveFileUrl(meta);
                return (
                  <tr>
                    <td class="typecho-select-cell"><input type="checkbox" value={String(att.cid)} name="cid[]" /></td>
                    <td>
                      <a href={`/admin/media?cid=${att.cid}`}>{att.title || ctx.i18n.t('admin.form.noName', {}, 'Unnamed')}</a>
                      <a href={`/admin/media?cid=${att.cid}`} title={`${ctx.i18n.t('admin.action.edit', {}, 'Edit')} ${att.title || ctx.i18n.t('admin.form.noName', {}, 'Unnamed')}`}><i class="i-edit"></i></a>
                      {fileUrl && (
                        <a href={fileUrl} title={ctx.i18n.t('admin.action.browse', {}, 'Browse')} target="_blank" rel="noopener noreferrer"><i class="i-exlink"></i></a>
                      )}
                      <br />
                      <span class="description">{isImage ? ctx.i18n.t('admin.status.image', {}, 'Image') : ctx.i18n.t('admin.status.file', {}, 'File')} - {formatBytes(parseInt(String(meta.size || '0'), 10) || 0)}</span>
                    </td>
                    <td class="kit-hidden-mb">{authorName || ctx.i18n.t('admin.status.unknown', {}, 'Unknown')}</td>
                    <td class="kit-hidden-mb">
                      {att.parent && parentTitle ? (
                        <a href={`/admin/write-post?cid=${att.parent}`}>{parentTitle}</a>
                      ) : (
                        <span class="description">{ctx.i18n.t('admin.status.unarchived', {}, 'Unarchived')}</span>
                      )}
                    </td>
                    <td>{formatDate(att.created || 0, 'Y-m-d', options.timezone, ctx.i18n.locale)}</td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </form>

    <div class="typecho-list-operate clearfix">
      <div class="operate-toolbar">
        <div class="operate">
          <label><i class="sr-only">{ctx.i18n.t('admin.action.selectAll', {}, 'Select all')}</i><input type="checkbox" class="typecho-table-select-all" /></label>
          <div class="btn-group btn-drop">
            <button class="btn dropdown-toggle btn-s" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="media-actions-bottom"><i class="sr-only">{ctx.i18n.t('admin.action.actions', {}, 'Actions')}</i>{ctx.i18n.t('admin.notice.selectAction', {}, 'Select an action')} <i class="i-caret-down"></i></button>
            <ul class="dropdown-menu" id="media-actions-bottom" role="menu">
              <li><a href="/api/admin/media-batch?do=delete">{ctx.i18n.t('admin.action.delete', {}, 'Delete')}</a></li>
            </ul>
          </div>
        </div>

        {totalPages > 1 && (
          <ul class="typecho-pager">
            {page > 1 && <li><a href={withQueryParams('/admin/manage-medias', { page: page - 1, keywords })}>&laquo;</a></li>}
            <li class="current"><a href="#">{page} / {totalPages}</a></li>
            {page < totalPages && <li><a href={withQueryParams('/admin/manage-medias', { page: page + 1, keywords })}>&raquo;</a></li>}
          </ul>
        )}
      </div>
    </div>
  </div>
</Admin>
