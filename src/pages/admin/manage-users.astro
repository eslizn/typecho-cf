---
import Admin from '@/layouts/Admin.astro';
import { createContext, requireAuth } from '@/lib/context';
import { hasPermission } from '@/lib/auth';
import { eq, sql, desc } from 'drizzle-orm';
import { schema } from '@/db';
import { formatDate } from '@/lib/content';
import { parsePageNumber, withQueryParams } from '@/lib/input';

const ctx = await createContext(Astro.locals, Astro.request);
const authCheck = requireAuth(ctx);
if (authCheck) return authCheck;

if (!hasPermission(ctx.user!.group || 'visitor', 'administrator')) {
  return new Response(ctx.i18n.t('core.error.forbidden', {}, 'Forbidden'), { status: 403 });
}

const { db, options, urls, user, csrfToken } = ctx;
const keywords = (Astro.url.searchParams.get('keywords') || '').trim().slice(0, 50);
const page = parsePageNumber(Astro.url.searchParams.get('page'));
const pageSize = 20;

const conditions: any[] = [];
if (keywords) {
  conditions.push(sql`(${schema.users.name} LIKE ${'%' + keywords + '%'} OR ${schema.users.screenName} LIKE ${'%' + keywords + '%'} OR ${schema.users.mail} LIKE ${'%' + keywords + '%'})`);
}

const where = conditions.length > 0 ? sql.join(conditions, sql` AND `) : undefined;

const [countResult, userRows] = await db.batch([
  db.select({ count: sql<number>`count(*)` }).from(schema.users).where(where),
  db.select({
    user: schema.users,
    postCount: sql<number>`(
      SELECT count(*) FROM ${schema.contents}
      WHERE ${schema.contents.authorId} = ${schema.users.uid}
        AND ${schema.contents.type} = 'post'
    )`,
  }).from(schema.users)
    .where(where)
    .orderBy(desc(schema.users.uid))
    .limit(pageSize)
    .offset((page - 1) * pageSize),
]);
const users = userRows.map(row => row.user);
const totalUsers = countResult[0]?.count || 0;
const totalPages = Math.max(1, Math.ceil(totalUsers / pageSize));
const postCountMap = new Map(userRows.map(row => [row.user.uid, row.postCount]));

const groupNames: Record<string, string> = {
  administrator: ctx.i18n.t('admin.option.administrator', {}, 'Administrator'),
  editor: ctx.i18n.t('admin.option.editor', {}, 'Editor'),
  contributor: ctx.i18n.t('admin.option.contributor', {}, 'Contributor'),
  subscriber: ctx.i18n.t('admin.option.subscriber', {}, 'Subscriber'),
  visitor: ctx.i18n.t('admin.option.visitor', {}, 'Visitor'),
};
---
<Admin title={ctx.i18n.t('admin.page.manageUsers', {}, 'Manage users')} options={options} urls={urls} user={user} activeMenu="manage-users" pluginCtx={ctx}>
  <div class="col-mb-12 typecho-list">
    <div class="typecho-list-operate clearfix">
      <form method="get">
        <div class="operate">
          <label><i class="sr-only">{ctx.i18n.t('admin.action.selectAll', {}, 'Select all')}</i><input type="checkbox" class="typecho-table-select-all" /></label>
          <div class="btn-group btn-drop">
            <button class="btn dropdown-toggle btn-s" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="user-actions"><i class="sr-only">{ctx.i18n.t('admin.action.actions', {}, 'Actions')}</i>{ctx.i18n.t('admin.notice.selectAction', {}, 'Select an action')} <i class="i-caret-down"></i></button>
            <ul class="dropdown-menu" id="user-actions" role="menu">
              <li><a href="/api/admin/user-batch?do=delete">{ctx.i18n.t('admin.action.delete', {}, 'Delete')}</a></li>
            </ul>
          </div>
          <a class="btn btn-s" href="/admin/user">{ctx.i18n.t('admin.action.add', {}, 'Add')} {ctx.i18n.t('admin.field.user', {}, 'user')}</a>
        </div>
        <div class="search" role="search">
          {keywords && <a href="/admin/manage-users">&laquo; {ctx.i18n.t('admin.action.clearFilter', {}, 'Clear filter')}</a>}
          <input type="text" class="text-s" placeholder={ctx.i18n.t('admin.search.placeholder', {}, 'Enter keywords')} value={keywords} name="keywords" />
          <button type="submit" class="btn btn-s">{ctx.i18n.t('admin.action.filter', {}, 'Filter')}</button>
        </div>
      </form>
    </div>

    <form method="post" name="manage_users" class="operate-form">
      <input type="hidden" name="_" value={csrfToken} />
      <div class="typecho-table-wrap">
        <table class="typecho-list-table">
          <colgroup>
            <col class="typecho-select-cell" />
            <col width="30%" />
            <col width="" class="kit-hidden-mb" />
            <col width="20%" class="kit-hidden-mb" />
            <col width="10%" class="kit-hidden-mb" />
            <col width="16%" />
          </colgroup>
          <thead>
            <tr>
              <th class="typecho-select-cell"></th>
              <th>{ctx.i18n.t('admin.field.username', {}, 'Username')}</th>
              <th class="kit-hidden-mb">{ctx.i18n.t('admin.field.nickname', {}, 'Nickname')}</th>
              <th class="kit-hidden-mb">{ctx.i18n.t('admin.field.email', {}, 'Email')}</th>
              <th class="kit-hidden-mb">{ctx.i18n.t('admin.field.posts', {}, 'Posts')}</th>
              <th>{ctx.i18n.t('admin.field.userGroup', {}, 'User group')}</th>
            </tr>
          </thead>
          <tbody>
            {users.length === 0 ? (
              <tr>
                <td colspan="6"><h6 class="typecho-list-table-title">{ctx.i18n.t('admin.notice.noUsers', {}, 'No users')}</h6></td>
              </tr>
            ) : (
              users.map((u) => (
                <tr>
                  <td class="typecho-select-cell">
                    {u.uid === user!.uid ? (
                      <input
                        type="checkbox"
                        disabled
                        aria-label={ctx.i18n.t('admin.user.selfSelect', {}, 'You cannot select your own account')}
                        title={ctx.i18n.t('admin.user.selfSelect', {}, 'You cannot select your own account')}
                      />
                    ) : (
                      <input type="checkbox" value={String(u.uid)} name="uid[]" />
                    )}
                  </td>
                  <td>
                    <a href={`/admin/user?uid=${u.uid}`}>{u.name}</a>
                    <a href={`/admin/user?uid=${u.uid}`} title={`${ctx.i18n.t('admin.action.edit', {}, 'Edit')} ${u.name}`}><i class="i-edit"></i></a>
                  </td>
                  <td class="kit-hidden-mb">{u.screenName || u.name}</td>
                  <td class="kit-hidden-mb">{u.mail ? <a href={`mailto:${u.mail}`}>{u.mail}</a> : '-'}</td>
                  <td class="kit-hidden-mb">
                    <a class="balloon-button size-small" href={`/admin/manage-posts?uid=${u.uid}`}>{postCountMap.get(u.uid) || 0}</a>
                  </td>
                  <td>{groupNames[u.group || 'visitor'] || u.group}</td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </form>

    {totalPages > 1 && (
      <div class="typecho-list-operate clearfix">
        <ul class="typecho-pager">
          {page > 1 && <li><a href={withQueryParams('/admin/manage-users', { page: page - 1, keywords })}>&laquo;</a></li>}
          <li class="current"><a href="#">{page} / {totalPages}</a></li>
          {page < totalPages && <li><a href={withQueryParams('/admin/manage-users', { page: page + 1, keywords })}>&raquo;</a></li>}
        </ul>
      </div>
    )}
  </div>
</Admin>
