---
import Admin from '@/layouts/Admin.astro';
import { createContext, requireAuth } from '@/lib/context';
import { hasPermission } from '@/lib/auth';
import { buildCategoryLink } from '@/lib/content';
import { and, eq } from 'drizzle-orm';
import { schema } from '@/db';

const ctx = await createContext(Astro.locals, Astro.request);
const authCheck = requireAuth(ctx);
if (authCheck) return authCheck;

if (!hasPermission(ctx.user!.group || 'visitor', 'editor')) {
  return new Response(ctx.i18n.t('core.error.forbidden', {}, 'Forbidden'), { status: 403 });
}

const { db, options, urls, user, csrfToken } = ctx;

// Editing
const editMid = Astro.url.searchParams.get('mid');
const editId = editMid ? parseInt(editMid, 10) : 0;
const [categories, editRows] = await db.batch([
  db.select().from(schema.metas)
    .where(eq(schema.metas.type, 'category'))
    .orderBy(schema.metas.order),
  db.select().from(schema.metas)
    .where(and(eq(schema.metas.mid, editId || -1), eq(schema.metas.type, 'category')))
    .limit(1),
]);
const editCat: any = editRows[0] ?? null;

const isDefault = (mid: number) => options.defaultCategory === mid;
---
<Admin title={ctx.i18n.t('admin.page.manageCategories', {}, 'Manage categories')} options={options} urls={urls} user={user} activeMenu="manage-categories" pluginCtx={ctx}>
  <div class="col-mb-12 typecho-list" role="main">
    <form method="post" name="manage_categories" class="operate-form">
      <input type="hidden" name="_" value={csrfToken} />
      <div class="typecho-list-operate clearfix">
        <div class="operate">
          <label><i class="sr-only">{ctx.i18n.t('admin.action.selectAll', {}, 'Select all')}</i><input type="checkbox" class="typecho-table-select-all" /></label>
          <div class="btn-group btn-drop">
            <button class="btn dropdown-toggle btn-s" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="category-actions"><i class="sr-only">{ctx.i18n.t('admin.action.actions', {}, 'Actions')}</i>{ctx.i18n.t('admin.notice.selectAction', {}, 'Select an action')} <i class="i-caret-down"></i></button>
            <ul class="dropdown-menu" id="category-actions" role="menu">
              <li><a href="/api/admin/meta?action=delete&type=category">{ctx.i18n.t('admin.action.delete', {}, 'Delete')}</a></li>
              <li><a href="/api/admin/meta?action=refresh&type=category">{ctx.i18n.t('admin.action.refresh', {}, 'Refresh')}</a></li>
            </ul>
          </div>
        </div>
      </div>

      <div class="typecho-table-wrap">
        <table class="typecho-list-table">
          <colgroup>
            <col width="20" class="kit-hidden-mb" />
            <col width="" />
            <col width="25%" class="kit-hidden-mb" />
            <col width="15%" />
            <col width="10%" class="kit-hidden-mb" />
          </colgroup>
          <thead>
            <tr class="nodrag">
              <th class="kit-hidden-mb"></th>
              <th>{ctx.i18n.t('admin.field.name', {}, 'Name')}</th>
              <th class="kit-hidden-mb">{ctx.i18n.t('admin.field.slug', {}, 'Slug')}</th>
              <th></th>
              <th class="kit-hidden-mb">{ctx.i18n.t('admin.field.posts', {}, 'Posts')}</th>
            </tr>
          </thead>
          <tbody>
            {categories.length === 0 ? (
              <tr>
                <td colspan="5"><h6 class="typecho-list-table-title">{ctx.i18n.t('admin.notice.noCategories', {}, 'No categories')}</h6></td>
              </tr>
            ) : (
              categories.map((cat) => (
                <tr id={`mid-${cat.mid}`}>
                  <td class="kit-hidden-mb"><input type="checkbox" value={String(cat.mid)} name="mid[]" /></td>
                  <td>
                    <a href={`/admin/manage-categories?mid=${cat.mid}`}>{cat.name}</a>
                    <a href={buildCategoryLink(cat.slug, urls.siteUrl, options.categoryPattern as string | undefined)} title={`${ctx.i18n.t('admin.action.browse', {}, 'Browse')} ${cat.name}`}><i class="i-exlink"></i></a>
                  </td>
                  <td class="kit-hidden-mb">{cat.slug}</td>
                  <td>
                    {isDefault(cat.mid) ? (
                      <span>{ctx.i18n.t('admin.status.default', {}, 'Default')}</span>
                    ) : (
                      <button type="submit"
                        class="hidden-by-mouse"
                        formaction={`/api/admin/meta?action=default&mid=${cat.mid}&type=category`}
                        formmethod="post"
                        title={ctx.i18n.t('admin.action.setDefault', {}, 'Set as default')}>{ctx.i18n.t('admin.status.default', {}, 'Default')}</button>
                    )}
                  </td>
                  <td class="kit-hidden-mb">
                    <a class="balloon-button left size-small" href={`/admin/manage-posts?category=${cat.mid}`}>{cat.count || 0}</a>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </form>

    <div class="typecho-mini-panel" style="margin-top: 20px;">
      <form method="post" action="/api/admin/meta">
        <input type="hidden" name="_" value={csrfToken} />
        <input type="hidden" name="action" value={editCat ? 'update' : 'create'} />
        <input type="hidden" name="type" value="category" />
        {editCat && <input type="hidden" name="mid" value={String(editCat.mid)} />}

        <h4>{editCat ? ctx.i18n.t('admin.form.editCategory', {}, 'Edit category') : ctx.i18n.t('admin.form.newCategory', {}, 'Add category')}</h4>

        <ul class="typecho-option">
          <li>
            <label for="name" class="typecho-label">{ctx.i18n.t('admin.field.name', {}, 'Name')} *</label>
            <input type="text" id="name" name="name" class="text w-100" value={editCat?.name || ''} required />
          </li>
          <li>
            <label for="slug" class="typecho-label">{ctx.i18n.t('admin.field.slug', {}, 'Slug')}</label>
            <input type="text" id="slug" name="slug" class="text w-100" value={editCat?.slug || ''} placeholder={ctx.i18n.t('admin.description.autoGenerateSlug', {}, 'Leave blank to generate automatically')} />
            <p class="description">{ctx.i18n.t('admin.description.categorySlug', {}, 'The category slug is used for friendly links. Use letters, numbers, underscores, and hyphens.')}</p>
          </li>
          <li>
            <label for="description" class="typecho-label">{ctx.i18n.t('admin.field.description', {}, 'Description')}</label>
            <textarea id="description" name="description" class="w-100 mono" rows="3">{editCat?.description || ''}</textarea>
            <p class="description">{ctx.i18n.t('admin.description.categoryDescription', {}, 'This text describes the category and may be shown by some themes.')}</p>
          </li>
        </ul>

        <p>
          <button type="submit" class="btn primary">{editCat ? ctx.i18n.t('admin.action.update', {}, 'Update') : ctx.i18n.t('admin.action.add', {}, 'Add')}</button>
          {editCat && <a href="/admin/manage-categories" class="btn">{ctx.i18n.t('admin.action.cancel', {}, 'Cancel')}</a>}
        </p>
      </form>
    </div>
  </div>
</Admin>
