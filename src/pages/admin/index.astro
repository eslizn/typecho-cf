---
import Admin from '@/layouts/Admin.astro';
import { createContext, requireAuth } from '@/lib/context';
import { hasPermission } from '@/lib/auth';
import { eq, and, sql, desc } from 'drizzle-orm';
import { schema } from '@/db';
import { buildPermalink, formatDate } from '@/lib/content';

const ctx = await createContext(Astro.locals, Astro.request);
const authCheck = requireAuth(ctx);
if (authCheck) return authCheck;

const { db, options, urls, user } = ctx;
const uid = user!.uid;
const isAdmin = hasPermission(user!.group || 'visitor', 'administrator');
const ownedCommentCondition = eq(schema.contents.authorId, uid);
const visibleCommentCondition = (status: string) => and(
  eq(schema.comments.status, status),
  ...(!isAdmin ? [ownedCommentCondition] : []),
);

// All dashboard cards are independent; one D1 batch avoids seven
// inter-region round-trips on every admin landing-page request.
const [
  postCount,
  commentCount,
  catCount,
  waitingComments,
  spamComments,
  recentPosts,
  recentComments,
] = await db.batch([
  db.select({ count: sql<number>`count(*)` }).from(schema.contents)
    .where(and(eq(schema.contents.type, 'post'), eq(schema.contents.status, 'publish'), eq(schema.contents.authorId, uid))),
  db.select({ count: sql<number>`count(*)` }).from(schema.comments)
    .innerJoin(schema.contents, eq(schema.comments.cid, schema.contents.cid))
    .where(ownedCommentCondition),
  db.select({ count: sql<number>`count(*)` }).from(schema.metas)
    .where(eq(schema.metas.type, 'category')),
  db.select({ count: sql<number>`count(*)` }).from(schema.comments)
    .leftJoin(schema.contents, eq(schema.comments.cid, schema.contents.cid))
    .where(visibleCommentCondition('waiting')),
  db.select({ count: sql<number>`count(*)` }).from(schema.comments)
    .leftJoin(schema.contents, eq(schema.comments.cid, schema.contents.cid))
    .where(visibleCommentCondition('spam')),
  db.select().from(schema.contents)
    .where(and(eq(schema.contents.type, 'post'), eq(schema.contents.status, 'publish')))
    .orderBy(desc(schema.contents.created))
    .limit(10),
  db.select({
    coid: schema.comments.coid,
    cid: schema.comments.cid,
    author: schema.comments.author,
    text: schema.comments.text,
    created: schema.comments.created,
    contentSlug: schema.contents.slug,
    contentType: schema.contents.type,
    contentCreated: schema.contents.created,
  }).from(schema.comments)
    .leftJoin(schema.contents, eq(schema.comments.cid, schema.contents.cid))
    .where(visibleCommentCondition('approved'))
    .orderBy(desc(schema.comments.created))
    .limit(10),
]);

const isContributor = hasPermission(user!.group || 'visitor', 'contributor');
---
<Admin title={ctx.i18n.t('admin.page.dashboard', {}, 'Dashboard')} options={options} urls={urls} user={user} activeMenu="dashboard" bodyClass="typecho-dashboard" pluginCtx={ctx}>
  <div class="col-mb-12 welcome-board" role="main">
    <p>
      {ctx.i18n.t('admin.dashboard.welcome', {
        posts: postCount[0]?.count || 0,
        comments: commentCount[0]?.count || 0,
        categories: catCount[0]?.count || 0,
      }, 'You have {posts} posts and {comments} comments in {categories} categories.')}
      <br />{ctx.i18n.t('admin.dashboard.quickStart', {}, 'Get started with one of these links:')}
    </p>
    <ul id="start-link" class="clearfix">
      {isContributor && <li><a href="/admin/write-post">{ctx.i18n.t('admin.dashboard.writePost', {}, 'Write a new post')}</a></li>}
      {(waitingComments[0]?.count || 0) > 0 && (
        <li>
          <a href="/admin/manage-comments?status=waiting">{ctx.i18n.t('admin.dashboard.waitingComments', {}, 'Pending comments')}</a>
          <span class="balloon">{waitingComments[0]?.count}</span>
        </li>
      )}
      {(spamComments[0]?.count || 0) > 0 && (
        <li>
          <a href="/admin/manage-comments?status=spam">{ctx.i18n.t('admin.dashboard.spamComments', {}, 'Spam comments')}</a>
          <span class="balloon">{spamComments[0]?.count}</span>
        </li>
      )}
      {isAdmin && (
        <>
          <li><a href="/admin/options-general">{ctx.i18n.t('admin.dashboard.systemSettings', {}, 'System settings')}</a></li>
        </>
      )}
    </ul>
  </div>

  <div class="col-mb-12 col-tb-4" role="complementary">
    <section class="latest-link">
      <h3>{ctx.i18n.t('admin.dashboard.recentPosts', {}, 'Recently published posts')}</h3>
      <ul>
        {recentPosts.length === 0 ? (
          <li><em>{ctx.i18n.t('admin.dashboard.noPosts', {}, 'No posts yet')}</em></li>
        ) : (
          recentPosts.map((post) => (
            <li>
              <span>{formatDate(post.created || 0, 'n.j', options.timezone, ctx.i18n.locale)}</span>
              <a href={buildPermalink({ cid: post.cid, slug: post.slug, type: post.type, created: post.created }, urls.siteUrl, options.permalinkPattern as string | undefined)} class="title">
                {post.title || ctx.i18n.t('core.content.untitled', {}, 'Untitled')}
              </a>
            </li>
          ))
        )}
      </ul>
    </section>
  </div>

  <div class="col-mb-12 col-tb-4" role="complementary">
    <section class="latest-link">
      <h3>{ctx.i18n.t('admin.dashboard.recentComments', {}, 'Recent replies')}</h3>
      <ul>
        {recentComments.length === 0 ? (
          <li>{ctx.i18n.t('admin.dashboard.noComments', {}, 'No replies yet')}</li>
        ) : (
          recentComments.map((comment) => (
            <li>
              <span>{formatDate(comment.created || 0, 'n.j', options.timezone, ctx.i18n.locale)}</span>
              <a href={`${buildPermalink(
                { cid: comment.cid, slug: comment.contentSlug, type: comment.contentType, created: comment.contentCreated },
                urls.siteUrl,
                options.permalinkPattern as string | undefined,
                options.pagePattern as string | undefined,
              )}#comment-${comment.coid}`} class="title">
                {comment.author || ctx.i18n.t('core.comment.anonymous', {}, 'Anonymous')}
              </a>:
              {(comment.text || '').replace(/<[^>]+>/g, '').substring(0, 35)}...
            </li>
          ))
        )}
      </ul>
    </section>
  </div>

  <div class="col-mb-12 col-tb-4" role="complementary">
    <section class="latest-link">
      <h3>{ctx.i18n.t('admin.dashboard.about', {}, 'About Typecho')}</h3>
      <ul>
        <li><a href="https://github.com/eslizn/typecho-cf" target="_blank">{ctx.i18n.t('admin.dashboard.projectHome', {}, 'Project home')}</a></li>
        <li>Astro + Cloudflare Workers</li>
        <li>{ctx.i18n.t('admin.dashboard.compatibility', {}, 'Typecho data compatible')}</li>
      </ul>
    </section>
  </div>
</Admin>
