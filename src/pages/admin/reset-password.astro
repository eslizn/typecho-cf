---
import { PASSWORD_MIN_LENGTH } from '@/lib/constants';
import { createContext } from '@/lib/context';
import { createCoreRequestI18n } from '@/lib/i18n-runtime';

// Standalone page — no Admin layout (user is not logged in).
const token = Astro.url.searchParams.get('token') || '';
let i18n = createCoreRequestI18n(Astro.request).i18n;
let charset = 'UTF-8';
try {
  const ctx = await createContext(Astro.locals, Astro.request);
  i18n = ctx.i18n;
  charset = String(ctx.options.charset || charset);
} catch {
  // The core translator is enough when the database is not ready.
}
---

<!DOCTYPE html>
<html lang={i18n.locale}>
<head>
  <meta charset={charset} />
  <meta name="renderer" content="webkit" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{i18n.t('admin.page.resetPassword', {}, 'Set a new password')}</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="stylesheet" href="/css/normalize.css" />
  <link rel="stylesheet" href="/css/grid.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
  <div class="typecho-login-wrap">
    <div class="typecho-login">
      <h1><a href="/">{i18n.t('admin.page.resetPassword', {}, 'Set a new password')}</a></h1>
      {!token && <div class="message error admin-notice admin-notice--error"><p>{i18n.t('admin.auth.missingResetToken', {}, 'Reset token is missing. Use the link from the email.')}</p></div>}
      {token && <form action="/api/users/reset-password" method="post">
        <input type="hidden" name="token" value={token} />
        <p>
          <label for="password" class="sr-only">{i18n.t('admin.auth.newPassword', {}, 'New password')}</label>
          <input type="password" id="password" name="password" class="text w-100" placeholder={i18n.t('admin.auth.newPasswordPlaceholder', { count: PASSWORD_MIN_LENGTH }, `Enter a new password (at least ${PASSWORD_MIN_LENGTH} characters)`)} required autofocus minlength={PASSWORD_MIN_LENGTH} />
        </p>
        <p>
          <label for="confirm" class="sr-only">{i18n.t('admin.auth.confirmNewPassword', {}, 'Confirm new password')}</label>
          <input type="password" id="confirm" name="confirm" class="text w-100" placeholder={i18n.t('admin.auth.confirmPasswordPlaceholder', {}, 'Enter the new password again')} required minlength={PASSWORD_MIN_LENGTH} />
        </p>
        <p class="submit">
          <button type="submit" class="btn primary w-100">{i18n.t('admin.auth.resetPassword', {}, 'Reset password')}</button>
        </p>
      </form>}
      <p class="more-link">
        <a href="/admin/login">{i18n.t('admin.auth.backToLogin', {}, 'Back to login')}</a>
      </p>
    </div>
  </div>
</body>
</html>
