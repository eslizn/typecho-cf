---
import type { SiteOptions } from '@/lib/options';
import type { computeUrls } from '@/lib/options';
import type { UserRow } from '@/lib/context';
import { getThemeStylesheets } from '@/lib/theme';
import { getClientSnippets, type PageContext, type HookContext } from '@/lib/plugin';
import { THEME_PREVIEW_OPTION, THEME_PREVIEW_QUERY_PARAM } from '@/lib/theme-preview';
import type { I18n } from '@/lib/i18n';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  options: SiteOptions;
  urls: ReturnType<typeof computeUrls>;
  user?: UserRow | null;
  isLoggedIn?: boolean;
  bodyClass?: string;
  pageContext?: PageContext;
  pluginCtx?: HookContext;
  i18n?: I18n;
}

const {
  title,
  description,
  keywords,
  options,
  urls,
  user,
  isLoggedIn = false,
  bodyClass = '',
  pageContext,
  pluginCtx,
  i18n,
} = Astro.props;

const pageTitle = title ? `${title} - ${options.title}` : options.title;
const pageI18n = i18n ?? pluginCtx?.i18n;
const documentLocale = pageI18n?.locale || (options.lang === 'zh_CN' ? 'zh-CN' : 'en');
const themeStylesheets = getThemeStylesheets(options.theme || 'typecho-theme-minimal');
const previewTheme = typeof options[THEME_PREVIEW_OPTION] === 'string'
  ? options[THEME_PREVIEW_OPTION]
  : '';

// Collect client-side snippets from all activated plugins
const pluginSnippets = await getClientSnippets(pluginCtx ?? { activatedPlugins: new Set<string>() }, options as Record<string, any>, pageContext);
---
<!DOCTYPE html>
<html lang={documentLocale}>
<head>
  <meta charset={options.charset || 'UTF-8'} />
  <meta name="renderer" content="webkit" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  {keywords && <meta name="keywords" content={keywords} />}
  {themeStylesheets.map((href) => (
    <link rel="stylesheet" href={href} />
  ))}
  <link rel="alternate" type="application/rss+xml" title={`${options.title} ${pageI18n?.t('core.frontend.postsRss', {}, 'Posts RSS') || 'Posts RSS'}`} href={urls.feedUrl} />
  <slot name="head" />
  <Fragment set:html={pluginSnippets.headHtml} />
</head>
<body class={bodyClass}>
  <slot />
  <Fragment set:html={pluginSnippets.bodyHtml} />
  {previewTheme && (
    <script is:inline data-preview-theme={previewTheme} data-preview-query={THEME_PREVIEW_QUERY_PARAM}>
      {`(() => {
        const script = document.currentScript;
        const theme = script?.dataset.previewTheme;
        const query = script?.dataset.previewQuery;
        if (!theme || !query) return;

        const decorate = (raw) => {
          if (!raw || raw.startsWith('#')) return raw;
          let url;
          try { url = new URL(raw, window.location.href); } catch { return raw; }
          if (url.origin !== window.location.origin || !/^https?:$/.test(url.protocol)) return raw;
          url.searchParams.set(query, theme);
          return url.toString();
        };

        const applyPreviewNavigation = () => {
          document.querySelectorAll('a[href]').forEach((link) => {
            const next = decorate(link.getAttribute('href'));
            if (next) link.setAttribute('href', next);
          });
          document.querySelectorAll('form[action]').forEach((form) => {
            if (!form.querySelector('input[name="s"]')) return;
            const next = decorate(form.getAttribute('action'));
            if (next) form.setAttribute('action', next);
          });
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', applyPreviewNavigation, { once: true });
        } else {
          applyPreviewNavigation();
        }
      })();`}
    </script>
  )}
</body>
</html>
