---
import Admin from '@/layouts/Admin.astro';
import { createContext, requireAuth } from '@/lib/context';
import { buildGravatarUrl } from '@/lib/gravatar';
import { eq, and, sql } from 'drizzle-orm';
import { schema } from '@/db';
import { PASSWORD_MIN_LENGTH } from '@/lib/constants';
import { applyFilterSafely } from '@/lib/plugin';

const ctx = await createContext(Astro.locals, Astro.request);
const authCheck = requireAuth(ctx);
if (authCheck) return authCheck;

const { db, options, urls, user, csrfToken } = ctx;

// Stats share one D1 round trip; Gravatar hashing is independent CPU work.
const [stats, gravatarUrl] = await Promise.all([
  db.batch([
    db.select({ count: sql<number>`count(*)` }).from(schema.contents)
      .where(and(eq(schema.contents.type, 'post'), eq(schema.contents.status, 'publish'), eq(schema.contents.authorId, user!.uid))),
    db.select({ count: sql<number>`count(*)` }).from(schema.comments)
      .innerJoin(schema.contents, eq(schema.comments.cid, schema.contents.cid))
      .where(eq(schema.contents.authorId, user!.uid)),
    db.select({ count: sql<number>`count(*)` }).from(schema.metas)
      .where(eq(schema.metas.type, 'category')),
  ]),
  buildGravatarUrl(user!.mail, { size: 220, defaultImage: 'mp' }),
]);
const [postCount, commentCount, catCount] = stats;
const profileBottomHtml = await applyFilterSafely(ctx, 'admin:profile:bottom', '', { options, urls, user, csrfToken });
---
<Admin title={ctx.i18n.t('admin.page.profile', {}, 'Profile')} options={options} urls={urls} user={user} activeMenu="profile" pluginCtx={ctx}>
  <div class="col-mb-12 col-tb-3">
    <p>
      <a href="https://gravatar.com/emails/" title={ctx.i18n.t('admin.profile.changeAvatar', {}, 'Change avatar on Gravatar')}>
        <img class="profile-avatar" src={gravatarUrl} alt={user!.screenName || user!.name || ''} />
      </a>
    </p>
    <h2>{user!.screenName || user!.name}</h2>
    <p>{user!.name}</p>
    <p>
      {ctx.i18n.t('admin.profile.stats', {
        posts: postCount[0]?.count || 0,
        comments: commentCount[0]?.count || 0,
        categories: catCount[0]?.count || 0,
      }, 'You have {posts} posts, {comments} comments, in {categories} categories.')}
    </p>
  </div>

  <div class="col-mb-12 col-tb-6 col-tb-offset-1 admin-panel" role="form">
    <section>
      <h3>{ctx.i18n.t('admin.profile.personal', {}, 'Profile')}</h3>
      <form method="post" action="/api/admin/profile">
        <input type="hidden" name="_" value={csrfToken} />
        <ul class="typecho-option">
          <li>
            <label class="typecho-label">{ctx.i18n.t('admin.field.username', {}, 'Username')}</label>
            <p><input type="text" class="text w-100" value={user!.name || ''} disabled /></p>
            <p class="description">{ctx.i18n.t('admin.description.usernameImmutable', {}, 'The username is the login identifier and cannot be changed after creation.')}</p>
          </li>
          <li>
            <label for="screenName" class="typecho-label">{ctx.i18n.t('admin.field.nickname', {}, 'Nickname')}</label>
            <p><input type="text" id="screenName" name="screenName" class="text w-100" value={user!.screenName || ''} /></p>
            <p class="description">{ctx.i18n.t('admin.description.nickname', {}, 'The nickname can differ from the username and is shown publicly.')}</p>
          </li>
          <li>
            <label for="mail" class="typecho-label">{ctx.i18n.t('admin.field.email', {}, 'Email')}</label>
            <p><input type="email" id="mail" name="mail" class="text w-100" value={user!.mail || ''} required /></p>
            <p class="description">{ctx.i18n.t('admin.description.userContact', {}, "This email address is used as the user's contact address.")}</p>
          </li>
          <li>
            <label for="url" class="typecho-label">{ctx.i18n.t('admin.field.website', {}, 'Website')}</label>
            <p><input type="url" id="url" name="url" class="text w-100" value={user!.url || ''} /></p>
            <p class="description">{ctx.i18n.t('admin.description.website', {}, 'Start with http:// or https://.')}</p>
          </li>
        </ul>
        <ul class="typecho-option typecho-option-submit">
          <li>
            <button type="submit" class="btn primary">{ctx.i18n.t('admin.profile.updateProfile', {}, 'Update profile')}</button>
          </li>
        </ul>
      </form>
    </section>

    <br />

    <section id="change-password">
      <h3>{ctx.i18n.t('admin.profile.passwordChange', {}, 'Change password')}</h3>
      <form method="post" action="/api/admin/profile">
        <input type="hidden" name="_" value={csrfToken} />
        <ul class="typecho-option">
          <li>
            <label for="current-password" class="typecho-label">{ctx.i18n.t('admin.field.currentPassword', {}, 'Current password')}</label>
            <p><input type="password" id="current-password" name="currentPassword" class="text w-100" autocomplete="current-password" required /></p>
            <p class="description">{ctx.i18n.t('admin.description.currentPasswordRequired', {}, 'The current password is required before changing it.')}</p>
          </li>
          <li>
            <label for="password" class="typecho-label">{ctx.i18n.t('admin.field.password', {}, 'Password')}</label>
            <p><input type="password" id="password" name="password" class="text w-100" autocomplete="new-password" minlength={PASSWORD_MIN_LENGTH} required /></p>
            <p class="description">{ctx.i18n.t('admin.description.passwordStrength', { count: PASSWORD_MIN_LENGTH }, `Use at least ${PASSWORD_MIN_LENGTH} characters and avoid an easy-to-guess password.`)}</p>
          </li>
          <li>
            <label for="confirm" class="typecho-label">{ctx.i18n.t('admin.field.confirmPassword', {}, 'Confirm password')}</label>
            <p><input type="password" id="confirm" name="passwordConfirm" class="text w-100" autocomplete="new-password" minlength={PASSWORD_MIN_LENGTH} required /></p>
            <p class="description">{ctx.i18n.t('admin.description.passwordConfirm', {}, 'Enter the password again to confirm it.')}</p>
          </li>
        </ul>
        <input type="hidden" name="screenName" value={user!.screenName || ''} />
        <input type="hidden" name="mail" value={user!.mail || ''} />
        <ul class="typecho-option typecho-option-submit">
          <li>
            <button type="submit" class="btn primary">{ctx.i18n.t('admin.profile.updatePassword', {}, 'Update password')}</button>
          </li>
        </ul>
      </form>
    </section>

    {profileBottomHtml && <Fragment set:html={profileBottomHtml} />}
  </div>
</Admin>
