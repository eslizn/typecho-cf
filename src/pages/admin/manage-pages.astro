---
import Admin from '@/layouts/Admin.astro';
import { createContext, requireAuth } from '@/lib/context';
import { hasPermission } from '@/lib/auth';
import { eq, sql, desc } from 'drizzle-orm';
import { schema } from '@/db';
import { formatDate, buildPermalink } from '@/lib/content';

const ctx = await createContext(Astro.locals, Astro.request);
const authCheck = requireAuth(ctx);
if (authCheck) return authCheck;
if (!hasPermission(ctx.user!.group || 'visitor', 'editor')) {
  return new Response(ctx.i18n.t('core.error.forbidden', {}, 'Forbidden'), { status: 403 });
}

const { db, options, urls, user, csrfToken } = ctx;
const keywords = Astro.url.searchParams.get('keywords') || '';

const conditions: any[] = [
  sql`${schema.contents.type} IN ('page', 'page_draft')`,
];
if (keywords) {
  conditions.push(sql`${schema.contents.title} LIKE ${'%' + keywords + '%'}`);
}

const pageRows = await db.select({
  content: schema.contents,
  authorUid: schema.users.uid,
  authorName: schema.users.name,
  authorScreenName: schema.users.screenName,
}).from(schema.contents)
  .leftJoin(schema.users, eq(schema.contents.authorId, schema.users.uid))
  .where(sql.join(conditions, sql` AND `))
  .orderBy(schema.contents.order, desc(schema.contents.created));
const pages = pageRows.map(row => row.content);
const authorMap = new Map(pageRows
  .filter(row => row.authorUid !== null)
  .map(row => [row.authorUid!, {
    uid: row.authorUid!,
    name: row.authorName,
    screenName: row.authorScreenName,
  }]));
const t = ctx.i18n.t.bind(ctx.i18n);
const tPlural = ctx.i18n.tPlural.bind(ctx.i18n);
---
<Admin title={t('admin.page.managePages', {}, 'Manage pages')} options={options} urls={urls} user={user} activeMenu="manage-pages" pluginCtx={ctx}>
  <div class="col-mb-12 typecho-list">
    <div class="typecho-list-operate clearfix">
      <form method="get">
        <div class="operate">
           <label><i class="sr-only">{t('admin.action.selectAll', {}, 'Select all')}</i><input type="checkbox" class="typecho-table-select-all" /></label>
          <div class="btn-group btn-drop">
             <button class="btn dropdown-toggle btn-s" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="page-actions"><i class="sr-only">{t('admin.action.actions', {}, 'Actions')}</i>{t('admin.notice.selectAction', {}, 'Select an action')} <i class="i-caret-down"></i></button>
            <ul class="dropdown-menu" id="page-actions" role="menu">
               <li><a href="/api/admin/content-batch?do=delete&type=page">{t('admin.action.delete', {}, 'Delete')}</a></li>
               <li><a href="/api/admin/content-batch?do=mark&status=publish&type=page">{t('admin.action.markAs', {}, 'Mark as ')}<strong>{t('admin.option.publish', {}, 'Published')}</strong></a></li>
               <li><a href="/api/admin/content-batch?do=mark&status=hidden&type=page">{t('admin.action.markAs', {}, 'Mark as ')}<strong>{t('admin.option.hidden', {}, 'Hidden')}</strong></a></li>
            </ul>
          </div>
        </div>
        <div class="search" role="search">
           {keywords && <a href="/admin/manage-pages">&laquo; {t('admin.action.clearFilter', {}, 'Clear filter')}</a>}
           <input type="text" class="text-s" placeholder={t('admin.search.placeholder', {}, 'Enter keywords')} value={keywords} name="keywords" />
           <button type="submit" class="btn btn-s">{t('admin.action.filter', {}, 'Filter')}</button>
        </div>
      </form>
    </div>

    <form method="post" name="manage_pages" class="operate-form">
      <input type="hidden" name="_" value={csrfToken} />
      <div class="typecho-table-wrap">
        <table class="typecho-list-table">
          <colgroup>
            <col class="typecho-select-cell" />
            <col width="6%" class="kit-hidden-mb" />
            <col width="30%" />
            <col width="30%" />
            <col width="" class="kit-hidden-mb" />
            <col width="16%" />
          </colgroup>
          <thead>
            <tr class="nodrag">
              <th class="typecho-select-cell"></th>
              <th class="kit-hidden-mb"></th>
               <th>{t('admin.field.title', {}, 'Title')}</th>
               <th>{t('admin.field.slug', {}, 'Slug')}</th>
               <th class="kit-hidden-mb">{t('admin.field.author', {}, 'Author')}</th>
               <th>{t('admin.field.date', {}, 'Date')}</th>
            </tr>
          </thead>
          <tbody>
            {pages.length === 0 ? (
              <tr>
                 <td colspan="6"><h6 class="typecho-list-table-title">{t('admin.notice.noPages', {}, 'No pages')}</h6></td>
              </tr>
            ) : (
              pages.map((pg) => {
                const author = authorMap.get(pg.authorId || 0);
                const isDraft = pg.type === 'page_draft';
                return (
                  <tr>
                    <td class="typecho-select-cell"><input type="checkbox" value={String(pg.cid)} name="cid[]" /></td>
                    <td class="kit-hidden-mb">
                      <a href={`/admin/manage-comments?cid=${pg.cid}`}
                        class="balloon-button size-small"
                         title={tPlural('admin.content.commentsCount', pg.commentsNum || 0, {}, '{count} comments')}>{pg.commentsNum || 0}</a>
                    </td>
                    <td>
                       <a href={`/admin/write-page?cid=${pg.cid}`}>{pg.title || t('core.content.untitled', {}, 'Untitled')}</a>
                       {isDraft && <em class="status">{t('admin.option.draft', {}, 'Draft')}</em>}
                       {pg.status === 'hidden' && <em class="status">{t('admin.option.hidden', {}, 'Hidden')}</em>}
                       <a href={`/admin/write-page?cid=${pg.cid}`} title={`${t('admin.action.edit', {}, 'Edit')} ${pg.title || t('core.content.untitled', {}, 'Untitled')}`}><i class="i-edit"></i></a>
                      {!isDraft && (
                        <a href={buildPermalink({ cid: pg.cid, slug: pg.slug, type: pg.type, created: pg.created }, urls.siteUrl, undefined, options.pagePattern as string | undefined)}
                           title={`${t('admin.action.browse', {}, 'Browse')} ${pg.title || t('core.content.untitled', {}, 'Untitled')}`}><i class="i-exlink"></i></a>
                      )}
                    </td>
                    <td>{pg.slug}</td>
                     <td class="kit-hidden-mb">{author?.screenName || author?.name || t('admin.status.unknown', {}, 'Unknown')}</td>
                    <td>{formatDate(pg.created || 0, 'Y-m-d', options.timezone, ctx.i18n.locale)}</td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </form>
  </div>
</Admin>
