---
import Admin from '@/layouts/Admin.astro';
import { createContext, requireAuth } from '@/lib/context';
import { hasPermission } from '@/lib/auth';
import { eq } from 'drizzle-orm';
import { schema } from '@/db';
import { formatDate } from '@/lib/content';

const ctx = await createContext(Astro.locals, Astro.request);
const authCheck = requireAuth(ctx);
if (authCheck) return authCheck;

if (!hasPermission(ctx.user!.group || 'visitor', 'editor')) {
  return new Response(ctx.i18n.t('core.error.forbidden', {}, 'Forbidden'), { status: 403 });
}

const { db, options, urls, user, csrfToken } = ctx;
const cid = parseInt(Astro.url.searchParams.get('cid') || '0', 10);

if (!cid) {
  return new Response(null, { status: 302, headers: { Location: '/admin/manage-medias' } });
}

const attachment = await db.query.contents.findFirst({
  where: eq(schema.contents.cid, cid),
});

if (!attachment || attachment.type !== 'attachment') {
  return new Response(null, { status: 302, headers: { Location: '/admin/manage-medias' } });
}

let meta: any = {};
try { meta = JSON.parse(attachment.text || '{}'); } catch {}

// Normalize meta fields for compatibility with legacy data
// Legacy format: {"name":"img.jpg","path":"usr/uploads/...","size":"12345","type":"jpg"}
// New format:    {"name":"img.jpg","path":"usr/uploads/...","size":12345,"type":"image/jpeg","url":"https://..."}
const imageExtensions = ['jpg', 'jpeg', 'png', 'gif', 'webp', 'svg', 'bmp', 'avif'];
const mimeType = meta.type || '';
const isImage = mimeType.startsWith('image/')
  || imageExtensions.includes(mimeType.toLowerCase())
  || imageExtensions.some(ext => (meta.name || '').toLowerCase().endsWith('.' + ext));

// Build file URL: prefer meta.url, fallback to constructing from meta.path
let fileUrl = meta.url || '';
if (!fileUrl && meta.path) {
  fileUrl = '/' + meta.path.replace(/^\//, '');
}

// Convert absolute URL to relative path for the link input
let relativeUrl = fileUrl;
try {
  if (relativeUrl && relativeUrl.startsWith('http')) {
    relativeUrl = new URL(relativeUrl).pathname;
  }
} catch {}

// Author and parent are independent once the attachment has been resolved.
const [authorRows, parentRows] = await db.batch([
  db.select().from(schema.users)
    .where(eq(schema.users.uid, attachment.authorId || -1))
    .limit(1),
  db.select().from(schema.contents)
    .where(eq(schema.contents.cid, attachment.parent || -1))
    .limit(1),
]);
const author = authorRows[0] ?? null;
const parentContent = parentRows[0] ?? null;

function formatBytes(bytes: number): string {
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024 * 1024) return Math.ceil(bytes / 1024) + ' KB';
  return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
}
---
<Admin title={ctx.i18n.t('admin.form.editMedia', {}, 'Edit media')} options={options} urls={urls} user={user} activeMenu="manage-medias" pluginCtx={ctx}>
  <div class="col-mb-12 col-tb-4 admin-panel" role="complementary">
    {isImage && fileUrl ? (
      <p><a href={fileUrl} target="_blank" rel="noopener noreferrer">
        <img src={fileUrl} alt={attachment.title || ''} class="typecho-attachment-photo admin-media-preview" />
      </a></p>
    ) : (
      <div class="admin-media-fallback">
        <strong>{(meta.type || 'file').split('/').pop()?.toUpperCase() || 'FILE'}</strong>
      </div>
    )}

    <ul class="typecho-option">
      <li>
        <span class="typecho-label">{ctx.i18n.t('admin.field.name', {}, 'Name')}</span>
        <p>{meta.name || attachment.title || ctx.i18n.t('admin.status.unknown', {}, 'Unknown')}</p>
      </li>
      <li>
        <span class="typecho-label">{ctx.i18n.t('admin.field.type', {}, 'Type')}</span>
        <p>{mimeType || ctx.i18n.t('admin.status.unknown', {}, 'Unknown')}</p>
      </li>
      <li>
        <span class="typecho-label">{ctx.i18n.t('admin.field.size', {}, 'Size')}</span>
        <p>{formatBytes(parseInt(String(meta.size || '0'), 10) || 0)}</p>
      </li>
      <li>
        <span class="typecho-label">{ctx.i18n.t('admin.field.author', {}, 'Author')}</span>
        <p>{author?.screenName || author?.name || ctx.i18n.t('admin.status.unknown', {}, 'Unknown')}</p>
      </li>
      <li>
        <span class="typecho-label">{ctx.i18n.t('admin.field.date', {}, 'Date')}</span>
        <p>{formatDate(attachment.created || 0, 'Y-m-d H:i', options.timezone, ctx.i18n.locale)}</p>
      </li>
      {parentContent && (
        <li>
          <span class="typecho-label">{ctx.i18n.t('admin.field.content', {}, 'Content')}</span>
          <p><a href={`/admin/write-post?cid=${parentContent.cid}`}>{parentContent.title || ctx.i18n.t('core.content.untitled', {}, 'Untitled')}</a></p>
        </li>
      )}
    </ul>
  </div>

  <div class="col-mb-12 col-tb-6 col-tb-offset-1 admin-panel" role="form">
    <form method="post" action="/api/admin/media">
      <input type="hidden" name="_" value={csrfToken} />
      <input type="hidden" name="cid" value={String(cid)} />

      <ul class="typecho-option">
        <li>
          <label for="name" class="typecho-label">{ctx.i18n.t('admin.form.fileTitle', {}, 'File title')}</label>
          <p><input type="text" id="name" name="name" class="text w-100" value={attachment.title || ''} /></p>
          <p class="description">{ctx.i18n.t('admin.description.fileTitle', {}, 'The file title is shown on the public site and can be changed.')}</p>
        </li>
        <li>
          <label for="slug" class="typecho-label">{ctx.i18n.t('admin.field.slug', {}, 'Slug')}</label>
          <p><input type="text" id="slug" name="slug" class="text w-100" value={attachment.slug || ''} /></p>
        </li>
        <li>
          <label class="typecho-label">{ctx.i18n.t('admin.form.fileLink', {}, 'File URL')}</label>
          <p><input type="text" class="text w-100 mono" value={relativeUrl} readonly onclick="this.select();" /></p>
          <p class="description">{ctx.i18n.t('admin.description.fileLink', {}, 'This URL can be referenced directly. Use a relative path so it remains portable.')}</p>
        </li>
      </ul>

      <ul class="typecho-option typecho-option-submit">
        <li>
          <button type="submit" class="btn primary">{ctx.i18n.t('admin.form.saveChanges', {}, 'Save changes')}</button>
          <a href="/admin/manage-medias" class="btn">{ctx.i18n.t('admin.action.back', {}, 'Back')}</a>
        </li>
      </ul>
    </form>

    <br />

    <form method="post" action="/api/admin/media" class="admin-media-delete-form">
      <input type="hidden" name="_" value={csrfToken} />
      <input type="hidden" name="cid" value={String(cid)} />
      <input type="hidden" name="do" value="delete" />
      <p>
        <button type="submit" class="btn btn-warn"
          onclick={`return confirm(${JSON.stringify(ctx.i18n.t('admin.notice.confirmDelete', {}, 'Are you sure you want to delete this item?'))});`}>
          {ctx.i18n.t('admin.form.deleteFile', {}, 'Delete file')}
        </button>
      </p>
    </form>
  </div>
</Admin>
