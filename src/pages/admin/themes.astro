---
import Admin from '@/layouts/Admin.astro';
import { createContext, requireAuth } from '@/lib/context';
import { hasPermission, requireAdminCSRF } from '@/lib/auth';
import { getAvailableThemes, themeHasConfig } from '@/lib/theme';

const ctx = await createContext(Astro.locals, Astro.request);
const authCheck = requireAuth(ctx);
if (authCheck) return authCheck;

if (!hasPermission(ctx.user!.group || 'visitor', 'administrator')) {
  return new Response(ctx.i18n.t('core.error.forbidden', {}, 'Forbidden'), { status: 403 });
}

const { options, urls, user, csrfToken } = ctx;

// Handle theme activation via POST
let message = '';
let messageType = '';

if (Astro.request.method === 'POST') {
  const csrfError = await requireAdminCSRF(Astro.request, options.secret as string, user!.authCode!, user!.uid, ctx.i18n);
  if (csrfError) return csrfError;
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action') as string;
    const themeId = formData.get('theme') as string;

    if (action === 'activate' && themeId) {
      const { setOption } = await import('@/lib/options');
      const { themeExists } = await import('@/lib/theme');

      if (themeExists(themeId)) {
        await setOption(ctx.db, 'theme', themeId);
        // Update local options to reflect change
        (options as any).theme = themeId;

        message = ctx.i18n.t('admin.theme.activated', { id: themeId }, `Theme switched to "${themeId}"`);
        messageType = 'success';
      } else {
        message = ctx.i18n.t('admin.theme.notFound', { id: themeId }, `Theme "${themeId}" does not exist`);
        messageType = 'error';
      }
    }
  } catch (e) {
    message = ctx.i18n.t('admin.error.operationFailed', {}, 'Operation failed');
    messageType = 'error';
  }
}

const themes = getAvailableThemes(options.theme || 'typecho-theme-minimal');
---
<Admin title={ctx.i18n.t('admin.page.themes', {}, 'Appearance')} options={options} urls={urls} user={user} activeMenu="themes" pluginCtx={ctx}>
  <div class="col-mb-12" role="main">
    {message && (
      <div class={`typecho-option-tabs notice typecho-dismissible admin-notice ${messageType === 'error' ? 'notice-error admin-notice--error' : 'notice-success admin-notice--success'}`}>
        <p>{message}</p>
        <button type="button" class="typecho-notice-close" aria-label={ctx.i18n.t('admin.action.closeNotice', {}, 'Close notice')}>&times;</button>
      </div>
    )}

    {themes.length === 0 ? (
      <div class="admin-panel admin-panel--empty">
        <h3>{ctx.i18n.t('admin.notice.noThemes', {}, 'No themes')}</h3>
      </div>
    ) : (
      <>

        <div class="typecho-list-operate clearfix">
          <div class="operate">
            <span>{ctx.i18n.t('admin.status.discovered', { count: themes.length }, '{count} items found')}</span>
          </div>
        </div>

        <div class="admin-theme-grid">
        {themes.map((theme) => (
          <div class:list={['admin-panel', 'admin-theme-card', { 'admin-theme-card--active': theme.isActive }]}>
            <div class="admin-theme-card__preview">
              {theme.manifest.screenshot ? (
                <img
                  src={theme.isDefault ? '/img/theme-default.png' : `/themes/${theme.id}/screenshot.${(theme.manifest.screenshot || 'png').split('.').pop()}`}
                  alt={theme.manifest.name}
                  class="admin-theme-card__image"
                  onerror="this.classList.add('hidden');this.parentElement.querySelector('.theme-fallback').classList.remove('hidden')"
                />
              ) : null}
              <div class:list={['theme-fallback', 'admin-theme-card__fallback', { hidden: !!theme.manifest.screenshot }]}>
                <div class="admin-theme-card__fallback-mark">T</div>
                <div>{theme.manifest.name}</div>
              </div>
            </div>

            {theme.isActive && (
              <div class="admin-badge admin-badge--active admin-theme-card__current">
                {ctx.i18n.t('admin.theme.current', {}, 'Current')}
              </div>
            )}

            <div class="admin-theme-card__body">
              <h3 class="admin-theme-card__title">{theme.manifest.name || theme.id}</h3>
              {theme.manifest.version && (
                <span class="admin-theme-card__version">v{theme.manifest.version}</span>
              )}

              {theme.manifest.description && (
                <p class="description admin-theme-card__description">
                  {theme.manifest.description}
                </p>
              )}

              <div class="admin-theme-card__meta">
                {theme.manifest.author && (
                  <span>
                    {ctx.i18n.t('admin.theme.author', {}, 'Author')}:
                    {theme.manifest.authorUrl ? (
                      <a href={theme.manifest.authorUrl} target="_blank" rel="noopener noreferrer">{theme.manifest.author}</a>
                    ) : (
                      theme.manifest.author
                    )}
                  </span>
                )}
                <span> · {theme.isDefault ? ctx.i18n.t('admin.status.builtIn', {}, 'Built-in') : ctx.i18n.t('admin.theme.npm', { packageName: theme.packageName }, `npm: ${theme.packageName}`)}</span>
              </div>

              <div class="admin-actions">
                {theme.isActive ? (
                  <span class="admin-badge admin-badge--muted">{ctx.i18n.t('admin.status.enabled', {}, 'Enabled')}</span>
                ) : (
                  <form method="post" action="/admin/themes" class="admin-inline-form">
                    <input type="hidden" name="_" value={csrfToken} />
                    <input type="hidden" name="action" value="activate" />
                    <input type="hidden" name="theme" value={theme.id} />
                    <button type="submit" class="btn btn-s primary">{ctx.i18n.t('admin.action.enable', {}, 'Enable')}</button>
                  </form>
                )}

                {themeHasConfig(theme.id) && (
                  <a href={`/admin/theme-config?id=${theme.id}`} class="btn btn-s">
                    {ctx.i18n.t('admin.action.settings', {}, 'Settings')}
                  </a>
                )}

                {theme.manifest.homepage && (
                  <a href={theme.manifest.homepage} target="_blank" rel="noopener noreferrer"
                    class="btn btn-s">
                    {ctx.i18n.t('admin.action.details', {}, 'Details')}
                  </a>
                )}

                <a href={`${urls.adminUrl}theme-preview?theme=${encodeURIComponent(theme.id)}`} target="_blank" rel="noopener noreferrer"
                  class="btn btn-s">
                  {ctx.i18n.t('admin.theme.preview', {}, 'Preview')}
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
      </>
    )}
  </div>
</Admin>
