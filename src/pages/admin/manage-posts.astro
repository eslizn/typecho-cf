---
import Admin from '@/layouts/Admin.astro';
import { createContext, requirePermission } from '@/lib/context';
import { hasPermission } from '@/lib/auth';
import { eq, and, desc, sql } from 'drizzle-orm';
import { schema } from '@/db';
import { formatDate, buildPermalink } from '@/lib/content';
import { applyFilterSafely } from '@/lib/plugin';
import { parsePageNumber, parsePositiveInteger, withQueryParams } from '@/lib/input';

const ctx = await createContext(Astro.locals, Astro.request);
// Posts management exposes other authors' content — contributor and
// above only (G2-3). Non-admin contributors are still scoped to their
// own posts via the WHERE clause below.
const authCheck = requirePermission(ctx, 'contributor');
if (authCheck) return authCheck;

const { db, options, urls, user, csrfToken } = ctx;
const isAdmin = hasPermission(user!.group || 'visitor', 'administrator');
const isEditor = hasPermission(user!.group || 'visitor', 'editor');

const page = parsePageNumber(Astro.url.searchParams.get('page'));
const status = Astro.url.searchParams.get('status') || '';
const keywords = (Astro.url.searchParams.get('keywords') || '').trim().slice(0, 50);
const category = Astro.url.searchParams.get('category') || '';
const requestedUid = parsePositiveInteger(Astro.url.searchParams.get('uid'));
const pageSize = 20;

// Build where conditions
const conditions: any[] = [
  sql`${schema.contents.type} IN ('post', 'post_draft')`,
];

if (!isAdmin) {
  conditions.push(eq(schema.contents.authorId, user!.uid));
} else if (requestedUid) {
  conditions.push(eq(schema.contents.authorId, requestedUid));
}

if (status === 'draft') {
  conditions.push(eq(schema.contents.type, 'post_draft'));
} else if (status === 'waiting') {
  conditions.push(eq(schema.contents.status, 'waiting'));
} else if (status === 'private') {
  conditions.push(eq(schema.contents.status, 'private'));
} else {
  conditions.push(eq(schema.contents.type, 'post'));
}

if (keywords) {
  conditions.push(sql`${schema.contents.title} LIKE ${'%' + keywords + '%'}`);
}

// Category filter via relationship join
let categoryFilter: number | null = null;
if (category) {
  categoryFilter = parseInt(category, 10) || null;
}

const where = and(...conditions);

// A correlated EXISTS keeps category filtering in SQL and avoids first loading
// every related cid. Independent list metadata shares the same D1 batch.
const categoryCondition = categoryFilter
  ? sql`EXISTS (
      SELECT 1 FROM ${schema.relationships}
      WHERE ${schema.relationships.cid} = ${schema.contents.cid}
        AND ${schema.relationships.mid} = ${categoryFilter}
    )`
  : undefined;
const listWhere = categoryCondition ? and(where, categoryCondition) : where;
const [countResult, posts, allCategories, draftCount, waitingCount] = await db.batch([
  db.select({ count: sql<number>`count(*)` }).from(schema.contents).where(listWhere),
  db.select().from(schema.contents)
    .where(listWhere)
    .orderBy(desc(schema.contents.created))
    .limit(pageSize)
    .offset((page - 1) * pageSize),
  db.select().from(schema.metas)
    .where(eq(schema.metas.type, 'category'))
    .orderBy(schema.metas.order),
  db.select({ count: sql<number>`count(*)` }).from(schema.contents)
    .where(and(eq(schema.contents.type, 'post_draft'), ...(!isAdmin ? [eq(schema.contents.authorId, user!.uid)] : []))),
  db.select({ count: sql<number>`count(*)` }).from(schema.contents)
    .where(and(eq(schema.contents.type, 'post'), eq(schema.contents.status, 'waiting'), ...(!isAdmin ? [eq(schema.contents.authorId, user!.uid)] : []))),
]);
const totalPosts = Number(countResult?.[0]?.count ?? 0);
const totalPages = Math.max(1, Math.ceil(totalPosts / pageSize));

const authorIds = [...new Set(posts.map(p => p.authorId).filter(Boolean))];
const postIds = posts.map(p => p.cid);
const safeAuthorIds = authorIds.length > 0 ? authorIds : [-1];
const safePostIds = postIds.length > 0 ? postIds : [-1];
const [authors, catData] = await db.batch([
  db.select().from(schema.users)
    .where(sql`${schema.users.uid} IN (${sql.join(safeAuthorIds.map(id => sql`${id}`), sql`, `)})`),
  db.select({ cid: schema.relationships.cid, name: schema.metas.name, mid: schema.metas.mid })
    .from(schema.relationships)
    .innerJoin(schema.metas, eq(schema.relationships.mid, schema.metas.mid))
    .where(and(
      sql`${schema.relationships.cid} IN (${sql.join(safePostIds.map(id => sql`${id}`), sql`, `)})`,
      eq(schema.metas.type, 'category')
    )),
]);
const authorMap = new Map(authors.map(a => [a.uid, a]));

// Categories for posts
const postCats = new Map<number, { name: string; mid: number }[]>();
for (const row of catData) {
  if (!postCats.has(row.cid)) postCats.set(row.cid, []);
  if (row.name) postCats.get(row.cid)!.push({ name: row.name, mid: row.mid });
}

const titleActionHtml = new Map<number, string>(
  await Promise.all(posts.map(async (post) => [
    post.cid,
    await applyFilterSafely(ctx, 'admin:managePosts:titleActions', '', { post, options, urls, user, i18n: ctx.i18n }),
  ] as [number, string]))
);
---
<Admin title={ctx.i18n.t('admin.page.managePosts', {}, 'Manage posts')} options={options} urls={urls} user={user} activeMenu="manage-posts" pluginCtx={ctx}>
  <div class="col-mb-12 typecho-list">
    <div class="clearfix">
      <ul class="typecho-option-tabs">
        <li class:list={[{ current: !status }]}>
          <a href="/admin/manage-posts">{ctx.i18n.t('admin.status.available', {}, 'Available')}</a>
        </li>
        <li class:list={[{ current: status === 'waiting' }]}>
          <a href="/admin/manage-posts?status=waiting">{ctx.i18n.t('admin.option.waiting', {}, 'Pending review')}
            {(waitingCount[0]?.count || 0) > 0 && <span class="balloon">{waitingCount[0]?.count}</span>}
          </a>
        </li>
        <li class:list={[{ current: status === 'draft' }]}>
          <a href="/admin/manage-posts?status=draft">{ctx.i18n.t('admin.option.draft', {}, 'Draft')}
            {(draftCount[0]?.count || 0) > 0 && <span class="balloon">{draftCount[0]?.count}</span>}
          </a>
        </li>
      </ul>
    </div>

    <div class="typecho-list-operate clearfix">
      <form method="get">
        <div class="operate">
          <label><i class="sr-only">{ctx.i18n.t('admin.action.selectAll', {}, 'Select all')}</i><input type="checkbox" class="typecho-table-select-all" /></label>
          <div class="btn-group btn-drop">
            <button class="btn dropdown-toggle btn-s" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="post-actions-top"><i class="sr-only">{ctx.i18n.t('admin.action.actions', {}, 'Actions')}</i>{ctx.i18n.t('admin.notice.selectAction', {}, 'Select an action')} <i class="i-caret-down"></i></button>
            <ul class="dropdown-menu" id="post-actions-top" role="menu">
              <li><a href="/api/admin/content-batch?do=delete">{ctx.i18n.t('admin.action.delete', {}, 'Delete')}</a></li>
              {isEditor && (
                <>
                  <li><a href="/api/admin/content-batch?do=mark&status=publish">{ctx.i18n.t('admin.action.markAs', {}, 'Mark as ')}<strong>{ctx.i18n.t('admin.option.publish', {}, 'Published')}</strong></a></li>
                  <li><a href="/api/admin/content-batch?do=mark&status=waiting">{ctx.i18n.t('admin.action.markAs', {}, 'Mark as ')}<strong>{ctx.i18n.t('admin.option.waiting', {}, 'Pending review')}</strong></a></li>
                  <li><a href="/api/admin/content-batch?do=mark&status=hidden">{ctx.i18n.t('admin.action.markAs', {}, 'Mark as ')}<strong>{ctx.i18n.t('admin.option.hidden', {}, 'Hidden')}</strong></a></li>
                  <li><a href="/api/admin/content-batch?do=mark&status=private">{ctx.i18n.t('admin.action.markAs', {}, 'Mark as ')}<strong>{ctx.i18n.t('admin.option.private', {}, 'Private')}</strong></a></li>
                </>
              )}
            </ul>
          </div>
        </div>
        <div class="search" role="search">
          {(keywords || category) && <a href={`/admin/manage-posts${status ? '?status=' + status : ''}`}>&laquo; {ctx.i18n.t('admin.action.clearFilter', {}, 'Clear filter')}</a>}
          <input type="text" class="text-s" placeholder={ctx.i18n.t('admin.search.placeholder', {}, 'Enter keywords')} value={keywords} name="keywords" />
          <select name="category">
            <option value="">{ctx.i18n.t('admin.option.allCategories', {}, 'All categories')}</option>
            {allCategories.map(cat => (
              <option value={String(cat.mid)} selected={category === String(cat.mid)}>{cat.name}</option>
            ))}
          </select>
          <button type="submit" class="btn btn-s">{ctx.i18n.t('admin.action.filter', {}, 'Filter')}</button>
          {status && <input type="hidden" value={status} name="status" />}
          {requestedUid && <input type="hidden" value={String(requestedUid)} name="uid" />}
        </div>
      </form>
    </div>

    <form method="post" name="manage_posts" class="operate-form">
      <input type="hidden" name="_" value={csrfToken} />
      <div class="typecho-table-wrap">
        <table class="typecho-list-table">
          <colgroup>
            <col class="typecho-select-cell" />
            <col width="6%" class="kit-hidden-mb" />
            <col width="45%" />
            <col width="" class="kit-hidden-mb" />
            <col width="18%" class="kit-hidden-mb" />
            <col width="16%" />
          </colgroup>
          <thead>
            <tr>
              <th class="typecho-select-cell"></th>
              <th class="kit-hidden-mb"></th>
              <th>{ctx.i18n.t('admin.field.title', {}, 'Title')}</th>
              <th class="kit-hidden-mb">{ctx.i18n.t('admin.field.author', {}, 'Author')}</th>
              <th class="kit-hidden-mb">{ctx.i18n.t('admin.field.category', {}, 'Category')}</th>
              <th>{ctx.i18n.t('admin.field.date', {}, 'Date')}</th>
            </tr>
          </thead>
          <tbody>
            {posts.length === 0 ? (
              <tr>
                <td colspan="6"><h6 class="typecho-list-table-title">{ctx.i18n.t('admin.notice.noPosts', {}, 'No posts')}</h6></td>
              </tr>
            ) : (
              posts.map((post) => {
                const author = authorMap.get(post.authorId || 0);
                const cats = postCats.get(post.cid) || [];
                const isDraft = post.type === 'post_draft';
                return (
                  <tr>
                    <td class="typecho-select-cell"><input type="checkbox" value={String(post.cid)} name="cid[]" /></td>
                    <td class="kit-hidden-mb">
                      <a href={`/admin/manage-comments?cid=${post.cid}`}
                        class="balloon-button size-small"
                        title={ctx.i18n.tPlural('admin.content.commentsCount', post.commentsNum || 0, {}, '{count} comments')}>{post.commentsNum || 0}</a>
                    </td>
                    <td>
                      <a href={`/admin/write-post?cid=${post.cid}`}>{post.title || ctx.i18n.t('core.content.untitled', {}, 'Untitled')}</a>
                      {isDraft && <em class="status">{ctx.i18n.t('admin.option.draft', {}, 'Draft')}</em>}
                      {post.status === 'hidden' && <em class="status">{ctx.i18n.t('admin.option.hidden', {}, 'Hidden')}</em>}
                      {post.status === 'waiting' && <em class="status">{ctx.i18n.t('admin.option.waiting', {}, 'Pending review')}</em>}
                      {post.status === 'private' && <em class="status">{ctx.i18n.t('admin.option.private', {}, 'Private')}</em>}
                      {post.password && post.status === 'publish' && <em class="status">{ctx.i18n.t('admin.status.passwordProtected', {}, 'Password protected')}</em>}
                      <a href={`/admin/write-post?cid=${post.cid}`} title={`${ctx.i18n.t('admin.action.edit', {}, 'Edit')} ${post.title || ctx.i18n.t('core.content.untitled', {}, 'Untitled')}`}><i class="i-edit"></i></a>
                      {!isDraft && (
                        <a href={buildPermalink({ cid: post.cid, slug: post.slug, type: post.type, created: post.created }, urls.siteUrl, options.permalinkPattern as string | undefined)}
                          title={`${ctx.i18n.t('admin.action.browse', {}, 'Browse')} ${post.title || ctx.i18n.t('core.content.untitled', {}, 'Untitled')}`}><i class="i-exlink"></i></a>
                      )}
                      {titleActionHtml.get(post.cid) && <Fragment set:html={titleActionHtml.get(post.cid)} />}
                    </td>
                    <td class="kit-hidden-mb">{author?.screenName || author?.name || ctx.i18n.t('admin.status.unknown', {}, 'Unknown')}</td>
                    <td class="kit-hidden-mb">
                      {cats.map((cat, i) => (
                        <>{i > 0 && ', '}<a href={`/admin/manage-posts?category=${cat.mid}`}>{cat.name}</a></>
                      ))}
                      {cats.length === 0 && ctx.i18n.t('admin.status.uncategorized', {}, 'Uncategorized')}
                    </td>
                    <td>{formatDate(post.created || 0, 'Y-m-d', options.timezone, ctx.i18n.locale)}</td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </form>

    <div class="typecho-list-operate clearfix">
      <div class="operate-toolbar">
        <div class="operate">
          <label><i class="sr-only">{ctx.i18n.t('admin.action.selectAll', {}, 'Select all')}</i><input type="checkbox" class="typecho-table-select-all" /></label>
          <div class="btn-group btn-drop">
            <button class="btn dropdown-toggle btn-s" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="post-actions-bottom"><i class="sr-only">{ctx.i18n.t('admin.action.actions', {}, 'Actions')}</i>{ctx.i18n.t('admin.notice.selectAction', {}, 'Select an action')} <i class="i-caret-down"></i></button>
            <ul class="dropdown-menu" id="post-actions-bottom" role="menu">
              <li><a href="/api/admin/content-batch?do=delete">{ctx.i18n.t('admin.action.delete', {}, 'Delete')}</a></li>
              {isEditor && (
                <>
                  <li><a href="/api/admin/content-batch?do=mark&status=publish">{ctx.i18n.t('admin.action.markAs', {}, 'Mark as ')}<strong>{ctx.i18n.t('admin.option.publish', {}, 'Published')}</strong></a></li>
                  <li><a href="/api/admin/content-batch?do=mark&status=waiting">{ctx.i18n.t('admin.action.markAs', {}, 'Mark as ')}<strong>{ctx.i18n.t('admin.option.waiting', {}, 'Pending review')}</strong></a></li>
                  <li><a href="/api/admin/content-batch?do=mark&status=hidden">{ctx.i18n.t('admin.action.markAs', {}, 'Mark as ')}<strong>{ctx.i18n.t('admin.option.hidden', {}, 'Hidden')}</strong></a></li>
                  <li><a href="/api/admin/content-batch?do=mark&status=private">{ctx.i18n.t('admin.action.markAs', {}, 'Mark as ')}<strong>{ctx.i18n.t('admin.option.private', {}, 'Private')}</strong></a></li>
                </>
              )}
            </ul>
          </div>
        </div>

        {totalPages > 1 && (
          <ul class="typecho-pager">
            {page > 1 && <li><a href={withQueryParams('/admin/manage-posts', { page: page - 1, status, keywords, category, uid: requestedUid })}>&laquo;</a></li>}
            <li class="current"><a href="#">{page} / {totalPages}</a></li>
            {page < totalPages && <li><a href={withQueryParams('/admin/manage-posts', { page: page + 1, status, keywords, category, uid: requestedUid })}>&raquo;</a></li>}
          </ul>
        )}
      </div>
    </div>
  </div>
</Admin>
